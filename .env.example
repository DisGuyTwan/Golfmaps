# Kress Connect (https://docs.connect.kress-robotik.com)
# Register an OAuth client at https://id.kress.com/developer, then set these in
# Vercel (Project → Settings → Environment Variables) or .env.local for dev.
# Never commit real values.

KRESS_CLIENT_ID=
KRESS_CLIENT_SECRET=
# Random string, at least 32 characters (encrypts the session cookies).
# Generate one with: openssl rand -base64 48
KRESS_SESSION_SECRET=

# Optional overrides
# KRESS_SCOPES="openid offline_access"      # if Kress requires specific API scopes
# KRESS_REDIRECT_URI=https://golfmaps.prodig-e.com/api/kress/callback
# KRESS_API_BASE_URL=https://api.connect.kress-robotik.com
# KRESS_ISSUER_URL=https://id.kress.com
